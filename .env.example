# Copy to .env for local runs. Never commit .env.
PORT=3000
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/wagering
DB_POOL_MAX=20
DB_LOCK_TIMEOUT_MS=5000
SQS_ENDPOINT=http://localhost:4566
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
SQS_WAGER_QUEUE=wager-transactions.fifo
SQS_WAGER_DLQ=wager-transactions-dlq.fifo
SQS_EVENTS_QUEUE=wagering-events.fifo
SQS_MAX_RECEIVE_COUNT=5
PENDING_REFERENCE_MAX_ATTEMPTS=10
PENDING_REFERENCE_TTL_MS=900000
LOG_LEVEL=info
