{
  "name": "distributed-wagering-processor",
  "version": "1.0.0",
  "private": true,
  "description": "Distributed wagering transaction processor (Jungle Gaming backend challenge)",
  "type": "module",
  "scripts": {
    "start": "bun src/main.ts",
    "start:prod": "bun dist/main.js",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "migration:up": "bun src/infrastructure/persistence/migrate.ts up",
    "migration:down": "bun src/infrastructure/persistence/migrate.ts down",
    "migration:status": "bun src/infrastructure/persistence/migrate.ts status",
    "sqs:setup": "bun scripts/setup-sqs.ts",
    "test": "bun test --timeout 120000",
    "test:unit": "bun test test/unit",
    "test:integration": "bun test --timeout 120000 test/integration",
    "test:concurrency": "bun test --timeout 180000 test/concurrency",
    "test:distributed": "bun test --timeout 240000 test/distributed",
    "test:adversarial": "bun test --timeout 240000 test/adversarial",
    "test:load": "bun scripts/load-test.ts",
    "test:all": "bun test --timeout 240000 test/unit test/integration test/concurrency test/distributed test/adversarial"
  },
  "dependencies": {
    "@aws-sdk/client-sqs": "3.1173.0",
    "@mikro-orm/core": "6.6.19",
    "@mikro-orm/migrations": "6.6.19",
    "@mikro-orm/postgresql": "6.6.19",
    "@nestjs/common": "11.2.11",
    "@nestjs/core": "11.2.11",
    "@nestjs/platform-express": "11.2.11",
    "decimal.js": "10.6.0",
    "prom-client": "15.1.3",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/express": "5.0.3",
    "typescript": "5.9.3"
  }
}
